# Google OAuth client created in the Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js session encryption secret (generate a unique value; never commit it).
AUTH_SECRET=replace-with-a-random-secret
AUTH_URL=http://localhost:8080

# Comma-separated emails that receive administrator access on sign-in.
ADMIN_EMAILS=admin@your-company.com
